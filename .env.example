# Salin ke .env lalu ganti nilai rahasianya. Jangan commit file .env.

# --- Database (dipakai docker-compose dan API) ---
POSTGRES_DB=maltajaya
POSTGRES_USER=maltajaya
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_PORT=5432
DATABASE_URL=postgres://maltajaya:ganti-dengan-password-kuat@localhost:5432/maltajaya

# --- API ---
PORT=5000
# Origin frontend yang boleh memanggil API (pisahkan dengan koma bila lebih dari satu).
CORS_ORIGIN=http://localhost:5173
# Minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# URL publik API, dipakai untuk membentuk URL foto produk.
PUBLIC_URL=http://localhost:5000
# Folder foto produk (relatif terhadap folder backend).
UPLOAD_DIR=uploads
