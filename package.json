{
  "name": "maltajaya-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API /api/v1 Sistem Operasional Maltajaya (Express + PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=src --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d db",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "seed:users": "node --env-file=.env scripts/seed-users.js",
    "seed:products": "node --env-file=.env scripts/seed-products.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  }
}
